# MongoDB Connection
# For production: use real MongoDB Atlas or on-premise MongoDB
# For development: leave empty to use embedded in-memory MongoDB (mongodb-memory-server)
MONGO_URI=

# JWT Secret for authentication
# Change this in production to a strong random string
JWT_SECRET=devsecret

# Server Configuration
PORT=5000

# ETL Pipeline Configuration
# Number of records per MongoDB bulkWrite batch (5000 recommended for performance/memory balance)
UPLOAD_BATCH_SIZE=5000

# Memory audit limits (in MB)
# If peak RSS exceeds this during processing, backpressure is applied
MEMORY_AUDIT_LIMIT_MB=150

# WebSocket progress update throttle (milliseconds)
# Higher values = fewer network updates, lower latency updates at cost of traffic
PROGRESS_THROTTLE_MS=300

# Row write concurrency (how many bulkWrite batches can be in-flight simultaneously)
# Higher values = faster throughput, but more concurrent MongoDB connections
ROW_WRITE_CONCURRENCY=3
