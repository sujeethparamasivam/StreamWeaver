# ⚠️ IMPORTANT: This file should NEVER be committed to git.
# It may contain sensitive credentials. Use server/.env.example as a template.
# To use a real MongoDB, add MONGO_URI and JWT_SECRET here.
# For development, leave MONGO_URI empty to use in-memory MongoDB.

MONGO_URI=
JWT_SECRET=dev-secret-change-in-production
PORT=5000
UPLOAD_BATCH_SIZE=5000
MEMORY_AUDIT_LIMIT_MB=150
PROGRESS_THROTTLE_MS=300
